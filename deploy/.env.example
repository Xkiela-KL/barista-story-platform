# Nach deploy/.env kopieren (nie committen) und ausfüllen.

# Schlüssel für die Verwaltungs-Endpunkte (/v1/admin). Erzeugen z. B. mit: openssl rand -base64 32
ADMIN_API_KEY=

# Öffentliche Adressen (Cloudflare Tunnel)
SITE_PUBLIC_URL=https://tv.xkiela.dev
API_PUBLIC_URL=https://api.xkiela.dev

# Ports auf dem Pi (nur 127.0.0.1). Vor dem ersten Start prüfen, ob sie frei sind: ss -tlnp
WEB_PORT=8086
API_PORT=8087

# Beim allerersten Start Barista Life mit Beispielterminen anlegen (danach ohne Wirkung)
SEED_CONTENT=true

# Suchmaschinen erst zulassen, wenn echte Termine und das Impressum eingetragen sind
ALLOW_INDEXING=false

# Impressum und Datenschutz
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
LEGAL_PHONE=

# Auf dem Pi (deploy.sh-Layout) vorgebaute Anwendungen verwenden:
#   BUILD_CONTEXT=.
#   DOCKERFILE=Dockerfile.prebuilt

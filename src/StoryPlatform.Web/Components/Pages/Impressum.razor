@page "/impressum"
@inject IOptions<SiteOptions> Site

<PageMeta Title="Impressum" Description="Anbieterkennzeichnung nach § 5 DDG." />

<article class="wrap section legal">
    <h1 class="page-title">Impressum</h1>
    @if (Missing)
    {
        <p class="legal-warning" role="note">Vorlage: Markierte Angaben fehlen noch (Einstellung <code>StoryWeb:Legal</code>). Bitte vor der Veröffentlichung ergänzen und rechtlich prüfen lassen.</p>
    }

    <h2>Angaben gemäß § 5 DDG</h2>
    <p>
        <Fill Value="@L.Name" Missing="Vor- und Nachname" /><br />
        <Fill Value="@L.Street" Missing="Straße und Hausnummer" /><br />
        <Fill Value="@L.PostalCodeAndCity" Missing="PLZ und Ort" />
    </p>

    <h2>Kontakt</h2>
    <p>
        E-Mail: <Fill Value="@L.Email" Missing="E-Mail-Adresse" />
        @if (!string.IsNullOrWhiteSpace(L.Phone))
        {
            <br /><span>Telefon: @L.Phone</span>
        }
    </p>

    <h2>Verantwortlich für den Inhalt</h2>
    <p><Fill Value="@(string.IsNullOrWhiteSpace(L.ResponsibleForContent) ? L.Name : L.ResponsibleForContent)" Missing="Name" />, Anschrift wie oben.</p>

    <h2>Haftung für Links</h2>
    <p>Diese Website verweist auf Folgen bei Instagram und TikTok. Für die Inhalte dieser externen Seiten sind ausschließlich deren Betreiber verantwortlich. Bei Bekanntwerden von Rechtsverletzungen entfernen wir entsprechende Links umgehend.</p>

    <h2>Urheberrecht</h2>
    <p>Geschichten, Illustrationen, Texte und Vertonungen der Serien sind urheberrechtlich geschützt. Eine Verwendung außerhalb der Grenzen des Urheberrechts bedarf der vorherigen Zustimmung.</p>
</article>

@code {
    private LegalOptions L => Site.Value.Legal;
    private bool Missing => new[] { L.Name, L.Street, L.PostalCodeAndCity, L.Email }.Any(string.IsNullOrWhiteSpace);
}

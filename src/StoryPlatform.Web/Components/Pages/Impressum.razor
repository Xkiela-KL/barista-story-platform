@page "/impressum"
@inject IOptions<SiteOptions> Site

<PageMeta Title="Impressum" Description="Anbieterkennzeichnung nach § 5 DDG." />

<article class="wrap section legal">
    <h1 class="page-title">Impressum</h1>
    @if (HasAddress)
    {
        <h2>Angaben gemäß § 5 DDG</h2>
        <p>@L.Name<br />@L.Street<br />@L.PostalCodeAndCity</p>
    }

    @if (!string.IsNullOrWhiteSpace(L.Email) || !string.IsNullOrWhiteSpace(L.Phone))
    {
        <h2>Kontakt</h2>
        <p>
            @if (!string.IsNullOrWhiteSpace(L.Email)) { <span>E-Mail: @L.Email</span><br /> }
            @if (!string.IsNullOrWhiteSpace(L.Phone)) { <span>Telefon: @L.Phone</span> }
        </p>
    }

    @if (HasAddress)
    {
        <h2>Verantwortlich für den Inhalt</h2>
        <p>@(string.IsNullOrWhiteSpace(L.ResponsibleForContent) ? L.Name : L.ResponsibleForContent), Anschrift wie oben.</p>
    }

    <h2>Haftung für Links</h2>
    <p>Diese Website verweist auf Folgen bei Instagram und TikTok. Für die Inhalte dieser externen Seiten sind ausschließlich deren Betreiber verantwortlich. Bei Bekanntwerden von Rechtsverletzungen entfernen wir entsprechende Links umgehend.</p>

    <h2>Urheberrecht</h2>
    <p>Geschichten, Illustrationen, Texte und Vertonungen der Serien sind urheberrechtlich geschützt. Eine Verwendung außerhalb der Grenzen des Urheberrechts bedarf der vorherigen Zustimmung.</p>
</article>

@code {
    private LegalOptions L => Site.Value.Legal;
    private bool HasAddress => !string.IsNullOrWhiteSpace(L.Name) && !string.IsNullOrWhiteSpace(L.Street) && !string.IsNullOrWhiteSpace(L.PostalCodeAndCity);
}

@if (Links.Count > 0)
{
    <div class="social">
        @if (Heading is not null)
        {
            <p class="social-heading">@Heading</p>
        }
        <ul class="social-list">
            @foreach (var link in Links)
            {
                <li>
                    @if (link.Url is not null)
                    {
                        <a class="social-link" href="@link.Url" rel="noopener" target="_blank">
                            <span class="social-platform">@Ui.PlatformName(link.Platform)</span>
                            @if (!string.IsNullOrWhiteSpace(link.Handle))
                            {
                                <span class="social-handle">@link.Handle</span>
                            }
                            <span class="visually-hidden">(öffnet in neuem Fenster)</span>
                        </a>
                    }
                    else
                    {
                        <span class="social-link is-pending">
                            <span class="social-platform">@Ui.PlatformName(link.Platform)</span>
                            <span class="social-handle">Link folgt</span>
                        </span>
                    }
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SocialLink> Links { get; set; } = [];
    [Parameter] public string? Heading { get; set; }
}

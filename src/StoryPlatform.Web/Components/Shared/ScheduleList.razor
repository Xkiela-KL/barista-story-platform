@* TV-guide rows: time first, then series and episode. *@
@if (Entries.Count == 0)
{
    <p class="empty">@EmptyText</p>
}
else
{
    <ol class="guide">
        @foreach (var e in Entries)
        {
            <li class="guide-row">
                <time class="guide-time" datetime="@Ui.Iso(e.ReleaseAt!.Value)">
                    @if (ShowDay)
                    {
                        <span class="guide-day">@BerlinTime.RelativeDay(e.ReleaseAt.Value, Now)</span>
                    }
                    <span class="guide-clock">@BerlinTime.Clock(e.ReleaseAt.Value)</span>
                </time>
                <div class="guide-main">
                    <a class="guide-series" href="@Ui.EpisodeUrl(e)">@e.SeriesTitle</a>
                    <span class="guide-episode">@Ui.EpisodeCode(e) · @e.Title</span>
                </div>
                <div class="guide-tags"><StatusChip Episode="e" /></div>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EpisodeView> Entries { get; set; } = [];
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public bool ShowDay { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Keine Folgen geplant.";
}
